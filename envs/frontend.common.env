# Blockscout frontend — settings common to every Konstellation network.
# Reference: upstream docker-compose/envs/common-frontend.env and
# https://github.com/blockscout/frontend/blob/main/docs/ENVS.md (v2.3.x).
# Network-specific values are interpolated from .env.<net> in docker-compose.yml.

NEXT_PUBLIC_NETWORK_CURRENCY_NAME=KASH
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=KASH
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses']
NEXT_PUBLIC_HAS_USER_OPS=true
NEXT_PUBLIC_VIEWS_CONTRACT_SOLIDITYSCAN_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
# Colour tokens come from branding/README.md; the values here are the
# placeholder palette until the real brand lands.
NEXT_PUBLIC_COLOR_THEME_DEFAULT=dim
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG='{"background":["linear-gradient(135deg, rgb(11,16,32) 0%, rgb(28,42,90) 100%)"],"text_color":["rgb(244,246,251)"]}'
# Wallet interaction (Write contract, Add network to MetaMask) needs a
# WalletConnect project id. Left unset: buttons stay hidden.
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
