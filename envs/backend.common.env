# Blockscout backend — settings common to every Konstellation network.
# Network-specific values (RPC URLs, CHAIN_ID, secrets) are interpolated from
# .env.<net> in docker-compose.yml and override anything here.
# Reference: upstream docker-compose/envs/common-blockscout.env and
# https://docs.blockscout.com/setup/env-variables (backend 9.0.x).

# ---- token: KASH, 18 decimals (ENGINEERING.md §1, D2). Blockscout takes
# the decimals from the EVM (18, always); COIN is a display symbol only.
COIN=KASH
COIN_NAME=KASH
# KASH has no CoinGecko listing; market data off so no polling and no zeros.
DISABLE_MARKET=true
EXCHANGE_RATES_COINGECKO_COIN_ID=

# ---- JSON-RPC (cosmos/evm v0.7.3 speaks the geth dialect; ENGINEERING.md §7.1)
ETHEREUM_JSONRPC_TRANSPORT=http
# Balances at historical blocks are fetched because the target is an archive
# node (scripts/check-rpc.sh refuses anything else). Do not set this to true
# to "fix" a pruned node — swap the node.
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false
# Per-transaction tracing (debug_traceTransaction), NOT block-level. Verified
# 2026-09-20 against cosmos/evm v0.7.3: its debug_traceBlockByNumber returns
# [{"result": {...}}] without the per-entry "txHash" geth >= 1.14 emits, and
# Blockscout 9.0.2's EthereumJSONRPC.Geth.extract_transactions_params crashes
# on it (FunctionClauseError in the InternalTransaction fetcher, every batch).
# Re-test before flipping this to true after a cosmos/evm bump.
ETHEREUM_JSONRPC_GETH_TRACE_BY_BLOCK=false
ETHEREUM_JSONRPC_HTTP_TIMEOUT=60
# The chain's first block is 1 (CometBFT has no block 0). With the default
# FIRST_BLOCK=0 the indexer waits for a block that never comes and
# /api/v2/main-page/indexing-status stays at indexed_blocks_ratio 0.99 with
# finished_indexing_blocks=false forever (the frontend banner never clears).
FIRST_BLOCK=1
TRACE_FIRST_BLOCK=1

# ---- indexer knobs for a low-throughput chain (1–2 s blocks, single-digit
# TPS at launch — ENGINEERING.md §7.3). Upstream defaults are tuned for
# mainnet Ethereum; smaller batches keep RPC bursts against the archive node
# gentle and keep memory low. Raise them if catch-up from genesis is slow.
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=10
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=4
INDEXER_RECEIPTS_BATCH_SIZE=50
INDEXER_RECEIPTS_CONCURRENCY=4
INDEXER_INTERNAL_TRANSACTIONS_BATCH_SIZE=5
INDEXER_INTERNAL_TRANSACTIONS_CONCURRENCY=2
INDEXER_COIN_BALANCES_BATCH_SIZE=50
INDEXER_COIN_BALANCES_CONCURRENCY=2
INDEXER_TOKEN_BALANCES_BATCH_SIZE=50
INDEXER_TOKEN_BALANCES_CONCURRENCY=2
# Most blocks on a young chain are empty; the sanitizer re-checks them.
INDEXER_EMPTY_BLOCKS_SANITIZER_BATCH_SIZE=50
# Pending txs come from txpool_*; the archive node exposes txpool but the
# Krakatoa app-side mempool (D13) is not geth's — leave the fetcher off until
# it is verified against a real node, so the indexer never stalls on it.
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
# No PoS block rewards on the EVM side (issuance is x/mint, D4); no
# beacon-chain withdrawals.
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_WITHDRAWALS_FETCHER=true
INDEXER_TX_ACTIONS_ENABLE=false
# Hard memory ceiling for the indexer, in GB (ConfigHelper.indexer_memory_limit).
INDEXER_MEMORY_LIMIT=2
# Elixir node memory: keep the BEAM from eating the box
INDEXER_SYSTEM_MEMORY_PERCENTAGE=60

# ---- gas price oracle (Explorer.Chain.Cache.GasPriceOracle). It takes the
# 35/60/90th percentiles of what transactions in the last NUM_OF_BLOCKS
# blocks paid (EIP-1559: priority fee capped by max_fee - base_fee, plus the
# base fee; zero-priced txs are excluded) and, with no priced tx in the
# window, falls back to the next block's base fee. Konstellation has no
# base-fee floor (TOKENOMICS.md §3: min_gas_price = 0), so an idle chain's
# base fee decays to 0 and that fallback is 0.0 — which the frontend renders
# as "N/A". 9.0.2 has no configurable floor (GAS_PRICE only feeds the
# `static_gas_price` API field, which the frontend ignores), so the one lever
# is the window. Trade-off, decided 2026-09-21 after a review: the oracle
# is trivially manipulable — anyone can send one overpriced self-transfer
# and every visitor sees that price until it leaves the window (a single
# 1000 gwei tx moved the tracker from 0.82 to 30.18 Gesp) — so a long
# window (28 800 blocks, ~8–12 h, tried first) makes the poison sticky,
# while upstream's 200 (3–5 min) leaves the tracker blank between txs.
# 2 400 blocks ≈ 40 min at 1 s / 1 h at 1.5 s: a poisoned price heals in
# an hour, and the tracker reads N/A after an hour of silence. 9.0.2 has
# no median/cap/outlier env; the percentiles below are the only shaping,
# and with a handful of samples they are the samples. Cost: one indexed
# query over the range every CACHE_PERIOD.
GAS_PRICE_ORACLE_NUM_OF_BLOCKS=2400
GAS_PRICE_ORACLE_CACHE_PERIOD=60s
GAS_PRICE_ORACLE_SAFELOW_PERCENTILE=35
GAS_PRICE_ORACLE_AVERAGE_PERCENTILE=60
GAS_PRICE_ORACLE_FAST_PERCENTILE=90
GAS_PRICE_ORACLE_SIMPLE_TRANSACTION_GAS=21000

# ---- token metadata fetch — SSRF guard (primary control). The indexer
# resolves every tokenURI host and refuses loopback, RFC 1918, link-local
# (169.254/16, cloud metadata), CGNAT, multicast and the documentation
# ranges (Explorer.MetadataURIValidator, on by default — pinned here so a
# future default change cannot silently open it). The compose networks are
# inside 10/8 and 172.16/12 already; the blacklist adds the IPv6
# equivalents. Infra egress rules are belt-and-braces on top (README).
INDEXER_TOKEN_INSTANCE_HOST_FILTERING_ENABLED=true
INDEXER_TOKEN_INSTANCE_ALLOWED_URI_PROTOCOLS=http,https
INDEXER_TOKEN_INSTANCE_CIDR_BLACKLIST=::1/128,fc00::/7,fe80::/10
# On-demand metadata refetch (POST …/refetch-metadata) is captcha-gated
# upstream; with RE_CAPTCHA_DISABLED=true (no captcha keys) it is open to
# anyone, throttled per instance by the 5 s threshold below and per client
# IP by the API rate limit. Acceptable for a refetch; revisit with a
# captcha key if abused.
TOKEN_INSTANCE_METADATA_REFETCH_ON_DEMAND_FETCHER_THRESHOLD=5s

# ---- API rate limit: the backend sits behind the nginx proxy (and the
# platform ingress), so without this every visitor shares one bucket keyed
# on the proxy's container IP — 500 requests per 15 min for the whole site.
# With it the client IP comes from X-Forwarded-For, which
# nginx/default.conf.template appends to. Buckets live in redis
# (API_RATE_LIMIT_HAMMER_REDIS_URL, docker-compose.yml) so they survive a
# backend restart.
API_RATE_LIMIT_IS_BLOCKSCOUT_BEHIND_PROXY=true
API_RATE_LIMIT_BY_IP=500

# ---- app
PORT=4000
POOL_SIZE=40
POOL_SIZE_API=10
ECTO_USE_SSL=false
HEART_BEAT_TIMEOUT=30
DISABLE_FILE_LOGGING=true
API_V2_ENABLED=true
DECODE_NOT_A_CONTRACT_CALLS=true
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
COIN_BALANCE_HISTORY_DAYS=90
# Blockscout "My account" (watchlists, tags) — needs an auth0 tenant; off.
ACCOUNT_ENABLED=false
RE_CAPTCHA_DISABLED=true
# Contract verification also tries Sourcify when the verifier service can't
# match; harmless on a chain Sourcify does not know, but leave it explicit.
SOURCIFY_INTEGRATION_ENABLED=false

# ---- microservices not run in this stack (upstream compose runs them; we
# keep the footprint to the essentials)
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
# NFT media: see envs/nft-media.common.env (NFT_MEDIA_HANDLER_ENABLED is set in docker-compose.yml)
