# NFT media handler (backend 9.0.2, apps/nft_media_handler) — settings shared
# by the backend ("producer": queues token-instance media) and the
# nft-media-handler container ("worker": fetches, resizes, uploads).
# Network-specific values (bucket, keys, cookie, folder) come from .env.<net>
# through docker-compose.yml.
#
# How it works, and what is fixed upstream:
# - Thumbnail sizes are hardcoded to 60x60, 250x250 and 500x500 px, the
#   original format/extension is kept (NFTMediaHandler.Image.Resizer). There
#   is no size/format env in this version.
# - Uploads go to an S3-compatible bucket over HTTPS on port 443 — the
#   scheme and port are hardcoded in config/runtime.exs (:ex_aws, :s3), only
#   host / bucket / keys / public URL are env. Cloudflare R2, AWS S3, or any
#   S3 API behind TLS works; plain-http MinIO does not (hence the local-s3
#   profile's self-signed cert + CA injection).
# - The browser loads thumbnails from NFT_MEDIA_HANDLER_AWS_PUBLIC_BUCKET_URL
#   + /<folder>/<file>, so the bucket (or a CDN in front) must allow
#   anonymous reads.
# - ipfs:// token URIs and images are resolved through IPFS_GATEWAY_URL by
#   the indexer before the worker fetches them.

# worker throughput — small: a young chain has few NFTs, and every fetch is
# an outbound request to an arbitrary host from inside our network
NFT_MEDIA_HANDLER_WORKER_CONCURRENCY=4
NFT_MEDIA_HANDLER_WORKER_BATCH_SIZE=5
NFT_MEDIA_HANDLER_WORKER_SPAWN_TASKS_TIMEOUT=100ms
NFT_MEDIA_HANDLER_CACHE_UNIQUENESS_MAX_SIZE=100000

# process token instances that were indexed before the handler was on
NFT_MEDIA_HANDLER_BACKFILL_ENABLED=true
NFT_MEDIA_HANDLER_BACKFILL_QUEUE_SIZE=1000
NFT_MEDIA_HANDLER_BACKFILL_ENQUEUE_BUSY_WAITING_TIMEOUT=1s

# the frontend fetches IPFS images itself through trustless gateways
# (Helia); leave upstream's default on
