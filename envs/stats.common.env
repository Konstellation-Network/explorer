# Blockscout stats service (blockscout-rs/stats). Reference: upstream
# docker-compose/envs/common-stats.env. DB URLs are set in docker-compose.yml.
STATS__SERVER__HTTP__ENABLED=true
STATS__SERVER__HTTP__ADDR=0.0.0.0:8050
STATS__SERVER__HTTP__MAX_BODY_SIZE=2097152
STATS__SERVER__GRPC__ENABLED=false
STATS__DEFAULT_SCHEDULE=0 0 1 * * * *
STATS__FORCE_UPDATE_ON_START=false
STATS__METRICS__ENABLED=false
STATS__JAEGER__ENABLED=false
STATS__TRACING__ENABLED=true
STATS__TRACING__FORMAT=default

# Chart labels. The shipped charts.json says ETH and Gwei; these are the
# per-chart env overrides the service documents (no custom file needed).
# native_coin_symbol feeds every "{{native_coin_symbol}}" title/description/
# units (fee charts, holders, transfers); average_gas_price is the one chart
# with a literal unit — Gesp = 10^9 esp, see envs/frontend.common.env.
STATS_CHARTS__TEMPLATE_VALUES__NATIVE_COIN_SYMBOL=KASH
STATS_CHARTS__LINE_CHARTS__AVERAGE_GAS_PRICE__UNITS=Gesp
STATS_CHARTS__LINE_CHARTS__AVERAGE_GAS_PRICE__DESCRIPTION=Average price (Gesp) per unit of gas
