# Konstellation explorer — LOCAL DEV CHAIN (EIP-155 56670; ENGINEERING.md §1 D1).
#   cd konstellation && ./local_node.sh -y      # JSON-RPC :8545, ws :8546,
#                                               # --pruning nothing, debug on
#   cd explorer && docker compose --env-file .env.local up -d
# Every value here is real for the dev chain; nothing is a placeholder.
# The dev node binds 127.0.0.1 — Docker Desktop reaches that through
# host.docker.internal; on Linux set [json-rpc] address/ws-address to
# 0.0.0.0 or run the node in the compose network (README).

CHAIN_ID=56670
NETWORK_DISPLAY_NAME=Konstellation local
IS_TESTNET=true

# --- RPC target: the dev node IS the archive node (local_node.sh starts it
# with --pruning nothing and the debug namespace)
RPC_HTTP_URL=http://host.docker.internal:8545
RPC_TRACE_URL=http://host.docker.internal:8545
RPC_WS_URL=ws://host.docker.internal:8546
# what the frontend offers to wallets ("add network")
PUBLIC_RPC_URL=http://127.0.0.1:8545

# --- where the browser reaches the stack (ports chosen not to collide with
# the node's 8545/8546 or anything privileged)
EXPLORER_HOST=localhost
EXPLORER_PROTOCOL=http
EXPLORER_WS_PROTOCOL=ws
EXPLORER_PORT=3080
# the port the browser dials, as the frontend's own variables (passed through
# by name; leave both unset when the public URL has no explicit port)
NEXT_PUBLIC_API_PORT=3080
NEXT_PUBLIC_APP_PORT=3080
EXPLORER_PUBLIC_URL=http://localhost:3080
STATS_PORT=3081
STATS_PUBLIC_URL=http://localhost:3081

# --- secrets: dev-only, public by design (same spirit as local_node.sh's
# mnemonics). Never reuse these on a network anyone else can reach.
# DB passwords are pasted into URLs unescaped: keep them URL-safe (real
# networks: `openssl rand -hex 32`).
POSTGRES_PASSWORD=blockscout-local
STATS_POSTGRES_PASSWORD=stats-local
SECRET_KEY_BASE=local-dev-only-56670-not-a-secret-0000000000000000000000000000000000
# published ports bind here; 127.0.0.1 keeps them off the LAN
EXPLORER_BIND=127.0.0.1

# --- NFT media (envs/nft-media.common.env): the `nft-media` profile runs the
# worker, and locally the `local-s3` profile runs MinIO as the bucket; the
# browser reads thumbnails through local-s3-proxy on :3082. All dev-only.
# The three switches go together: NFT_MEDIA_ENABLED, the profile, and
# RELEASE_DISTRIBUTION=name (the worker talks to the backend over Erlang
# distribution, confined to the internal `erlang` network).
COMPOSE_PROFILES=nft-media,local-s3
NFT_MEDIA_ENABLED=true
RELEASE_DISTRIBUTION=name
NFT_MEDIA_S3_HOST=minio
NFT_MEDIA_S3_BUCKET=nft-media
NFT_MEDIA_S3_FOLDER=local
NFT_MEDIA_S3_PUBLIC_URL=http://localhost:3082/nft-media
NFT_MEDIA_S3_ACCESS_KEY_ID=nft-media-local
NFT_MEDIA_S3_SECRET_ACCESS_KEY=nft-media-local-secret
LOCAL_S3_PUBLIC_PORT=3082
# lets the media worker's S3 client accept MinIO's self-signed cert (see the
# note above x-nft-media-env in docker-compose.yml); dev-only
NFT_MEDIA_S3_ERL_OPTIONS=-ex_aws hackney_opts [insecure,{recv_timeout,30000}]
# ipfs.io answers unauthenticated bursts with 429 (seen 2026-09-20); pinata's public gateway did not
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_PUBLIC_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# Erlang distribution cookie shared by backend and nft-media-handler (dev-only value)
RELEASE_COOKIE=local-dev-only-cookie-56670
