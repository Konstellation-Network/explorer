# Konstellation explorer — testnet-1 (EIP-155 56671; ENGINEERING.md §1, §18).
#   docker compose --env-file .env.testnet-1 config   # validate
#   docker compose --env-file .env.testnet-1 up -d
#
# PLACEHOLDERS: every `TODO` below is unknown until `infra` provisions the
# testnet-1 archive node (terraform/modules/*/archive, ansible group `archive`:
# pruning = "nothing", evm_tracer_enabled = true, not public — ENGINEERING.md
# §6.5, §9.2) and DNS for the explorer host exists. scripts/check-rpc.sh
# refuses to start the stack against anything that is not that archive node.

CHAIN_ID=56671
NETWORK_DISPLAY_NAME=Konstellation testnet-1
IS_TESTNET=true

# --- RPC target: the testnet-1 ARCHIVE node, reached over the private
# network / VPN, never the public RPC fleet (which is pruned).
RPC_HTTP_URL=http://TODO-testnet-1-archive-node:8545
RPC_TRACE_URL=http://TODO-testnet-1-archive-node:8545
RPC_WS_URL=ws://TODO-testnet-1-archive-node:8546
# public RPC the frontend offers to wallets — networks/testnet-1/chain.json
PUBLIC_RPC_URL=https://TODO-testnet-1-public-rpc

# --- public URL of the explorer (TLS terminated by the platform ingress,
# ENGINEERING.md §9.1; the proxy container listens on plain HTTP)
EXPLORER_HOST=TODO-testnet-1-explorer-hostname
EXPLORER_PROTOCOL=https
EXPLORER_WS_PROTOCOL=wss
EXPLORER_PORT=80
# The browser dials https://<host> with no explicit port, so the frontend's
# NEXT_PUBLIC_API_PORT / NEXT_PUBLIC_APP_PORT stay UNSET (passed through by
# name in docker-compose.yml). Never set them empty: the image's validator
# exits on "" and a set value ends up in every absolute URL it builds.
#NEXT_PUBLIC_API_PORT=
#NEXT_PUBLIC_APP_PORT=
# the proxy publishes on loopback only (the TLS ingress is on the same host;
# Docker-published ports bypass the host firewall). 0.0.0.0 only if the
# ingress is another machine.
EXPLORER_BIND=127.0.0.1
EXPLORER_PUBLIC_URL=https://TODO-testnet-1-explorer-hostname
STATS_PORT=8080
STATS_PUBLIC_URL=https://TODO-testnet-1-stats-hostname

# --- secrets: generate per deployment, keep in the platform's secret store,
# never commit. The two DB passwords are pasted into connection URLs
# unescaped (DATABASE_URL, STATS__*_URL, USER_OPS_INDEXER__DATABASE__*), so
# they must be URL-safe: `openssl rand -hex 32`. SECRET_KEY_BASE may be
# anything: `openssl rand -base64 48`.
POSTGRES_PASSWORD=TODO
STATS_POSTGRES_PASSWORD=TODO
SECRET_KEY_BASE=TODO

# --- NFT media (envs/nft-media.common.env). OFF until the network has an
# S3-compatible bucket reachable over HTTPS on 443 (Cloudflare R2 / AWS S3)
# with anonymous read on its public URL (or a CDN in front). To turn it on:
# fill the TODOs, then set NFT_MEDIA_ENABLED=true, COMPOSE_PROFILES=nft-media
# and RELEASE_DISTRIBUTION=name together (README "NFT media").
NFT_MEDIA_ENABLED=false
#COMPOSE_PROFILES=nft-media
#RELEASE_DISTRIBUTION=name
NFT_MEDIA_S3_HOST=TODO-s3-endpoint-hostname
NFT_MEDIA_S3_BUCKET=TODO-bucket-name
NFT_MEDIA_S3_FOLDER=testnet-1
NFT_MEDIA_S3_PUBLIC_URL=https://TODO-public-bucket-or-cdn-hostname/TODO-bucket-name
NFT_MEDIA_S3_ACCESS_KEY_ID=TODO
NFT_MEDIA_S3_SECRET_ACCESS_KEY=TODO
# ipfs.io is a public best-effort gateway that throttles bursts (429 seen);
# a paid/pinning gateway belongs here before NFT media goes live
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
IPFS_PUBLIC_GATEWAY_URL=https://ipfs.io/ipfs
# Erlang distribution cookie shared by backend and nft-media-handler — it is
# remote code execution on both nodes: `openssl rand -base64 32`, secret
# store, never commit
RELEASE_COOKIE=TODO
