# Local-only: plain-http front for the MinIO bucket so the browser can load
# NFT thumbnails without trusting the self-signed cert (profile `local-s3`).
server {
    listen       8082;
    server_name  _;
    resolver     127.0.0.11 valid=10s;
    location / {
        set $minio https://minio:443;
        proxy_pass            $minio;
        proxy_ssl_verify      off;
        proxy_ssl_server_name on;
        proxy_set_header      Host minio;
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Cache-Control' 'public, max-age=60' always;
    }
}
