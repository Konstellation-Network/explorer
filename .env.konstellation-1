# Konstellation explorer — konstellation-1 MAINNET (EIP-155 5667; ENGINEERING.md §1, §18).
#   docker compose --env-file .env.konstellation-1 config   # validate
#   docker compose --env-file .env.konstellation-1 up -d
#
# PLACEHOLDERS: every `TODO` below waits on `infra` provisioning the mainnet
# archive nodes (at least two, tracing on, not public — ENGINEERING.md §9.2)
# and on the explorer's DNS. Nothing here is deployed; mainnet genesis has
# not happened (STATUS.md §1). scripts/check-rpc.sh refuses to start the
# stack against anything that is not an archive node on chain 5667.

CHAIN_ID=5667
NETWORK_DISPLAY_NAME=Konstellation
IS_TESTNET=false

# --- RPC target: a mainnet ARCHIVE node over the private network. Point it at
# a load-balanced pair once both archive nodes exist (§9.2: "at least two").
RPC_HTTP_URL=http://TODO-konstellation-1-archive-node:8545
RPC_TRACE_URL=http://TODO-konstellation-1-archive-node:8545
RPC_WS_URL=ws://TODO-konstellation-1-archive-node:8546
# public RPC the frontend offers to wallets — networks/konstellation-1/chain.json
PUBLIC_RPC_URL=https://TODO-konstellation-1-public-rpc

# --- public URL of the explorer (TLS at the platform ingress, §9.1)
EXPLORER_HOST=TODO-konstellation-1-explorer-hostname
EXPLORER_PROTOCOL=https
EXPLORER_WS_PROTOCOL=wss
EXPLORER_PORT=80
EXPLORER_PUBLIC_PORT=
EXPLORER_PUBLIC_URL=https://TODO-konstellation-1-explorer-hostname
STATS_PORT=8080
STATS_PUBLIC_URL=https://TODO-konstellation-1-stats-hostname

# --- secrets: generate per deployment, keep in the platform's secret store,
# never commit. `openssl rand -base64 48` for each.
POSTGRES_PASSWORD=TODO
STATS_POSTGRES_PASSWORD=TODO
SECRET_KEY_BASE=TODO

# --- NFT media (envs/nft-media.common.env). Needs an S3-compatible bucket
# reachable over HTTPS on 443 (Cloudflare R2 / AWS S3) with anonymous read
# on its public URL (or a CDN in front). TODO until the bucket exists.
NFT_MEDIA_ENABLED=true
NFT_MEDIA_S3_HOST=TODO-s3-endpoint-hostname
NFT_MEDIA_S3_BUCKET=TODO-bucket-name
NFT_MEDIA_S3_FOLDER=konstellation-1
NFT_MEDIA_S3_PUBLIC_URL=https://TODO-public-bucket-or-cdn-hostname/TODO-bucket-name
NFT_MEDIA_S3_ACCESS_KEY_ID=TODO
NFT_MEDIA_S3_SECRET_ACCESS_KEY=TODO
# ipfs.io is a public best-effort gateway; a paid/pinning gateway can go here
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
IPFS_PUBLIC_GATEWAY_URL=https://ipfs.io/ipfs
# Erlang distribution cookie shared by backend and nft-media-handler:
# `openssl rand -base64 32`, secret store, never commit
RELEASE_COOKIE=TODO
